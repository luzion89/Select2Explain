{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Select2Explain",
  "version": "0.1.0",
  "identifier": "com.tuntun.select2explain",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Select2Explain",
        "width": 720,
        "height": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {}
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
